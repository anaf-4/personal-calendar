PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=personal-calendar

JWT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# No DISCORD_REDIRECT_URI here anymore — it's computed per-request from whichever
# host/IP the request came in on. Register EVERY address this server is reachable
# at (LAN IP, public IP, ...) as a Redirect URI in the Discord app's OAuth2 settings,
# each ending in /api/auth/callback/discord.

APP_CALLBACK_SCHEME=personalcalendar
